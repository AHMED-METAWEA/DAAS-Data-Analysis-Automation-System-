# Groq API key (primary LLM provider — used first by every agent)
# Get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Multi-provider LLM fallback chain. If the first provider in the list fails
# (timeout, rate limit, API error, empty response), the next one is tried.
# Any provider without an API key set below is skipped automatically.
LLM_PROVIDER_ORDER=groq,anthropic,openai,openrouter
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Per-minute token budget each request is sized against, because Groq bills a
# completion as `prompt + max_tokens` and rejects the call with HTTP 413 when
# the sum exceeds the ceiling — a 413 no amount of retrying can fix. The default
# is Groq's 8000 TPM on the free/on_demand tier. Raise it after upgrading a plan
# and reports get their full context and length back; there is nothing else to
# change. `LLM_TPM_LIMIT` applies to every provider, `LLM_TPM_LIMIT_<PROVIDER>`
# to one. 0 means "no ceiling worth modelling", which is the default for
# Anthropic, OpenAI and OpenRouter.
# LLM_TPM_LIMIT_GROQ=8000

# PostgreSQL connection — used both by docker-compose (to configure the
# container) and by the app (to connect). Start it with: docker compose up -d
# Port defaults to 5433 (not 5432) to avoid clashing with any native/other
# PostgreSQL install already using 5432 on this machine.
PG_HOST=localhost
PG_PORT=5433
PG_DBNAME=smart_analyst
PG_USER=postgres
PG_PASSWORD=postgres

# Fernet key for encrypting stored external DB connection credentials
# (Path B — existing-database linking). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Backend API (FastAPI) ---
# Secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Origin the API's CORS policy allows (the Next.js frontend's dev/prod URL).
FRONTEND_ORIGIN=http://localhost:3000

# --- Scheduled monitoring & proactive alerts (Pillar III-1) ---
# The scheduler is hosted inside the API process by default, so `uvicorn` alone
# is a complete deployment. Set to 0 to host it in `python -m monitoring.worker`
# instead. Running both is safe — a Postgres advisory lock makes a duplicate run
# a skip rather than a double delivery.
MONITORING_SCHEDULER=1
# Base URL put in the "open the full analysis" link inside briefings. Falls back
# to FRONTEND_ORIGIN; set it explicitly when the public URL differs from the
# CORS origin (behind a tunnel or a reverse proxy).
APP_PUBLIC_URL=http://localhost:3000

# Notification channel defaults. Each of these can also be stored per channel in
# the UI (encrypted with FERNET_KEY); these env vars are the single-tenant
# shortcut so a deployment can configure delivery once.

# Email (SMTP). Works with Gmail, Outlook, Mailgun, SendGrid or your own relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=DAAS

# Telegram — fastest channel to get working. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=

# WhatsApp. "meta" is the official Cloud API (production); "twilio" is the
# sandbox that works in minutes without business verification (demos).
WHATSAPP_PROVIDER=meta
# Meta WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Scheduled briefings normally fall OUTSIDE WhatsApp's 24-hour free-form window,
# so an approved message template is required for reliable delivery.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
