# FastAPI backend base URL (see ../README.md for how to run it).
# 127.0.0.1 rather than localhost on purpose: uvicorn binds IPv4 by default, while
# `localhost` resolves to ::1 first on a dual-stack machine — the literal keeps the
# two from disagreeing. Change it if the API runs elsewhere.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Leave blank and `npm run dev` will generate one into .env.local for you
# (scripts/setup-env.mjs). To set it yourself: openssl rand -base64 32
# A blank value here is never used at runtime — it would 500 every sign-in.
NEXTAUTH_SECRET=

# Optional OAuth providers — the Sign in page's Google/GitHub buttons only
# appear once the corresponding pair below is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
